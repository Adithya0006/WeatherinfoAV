def _is_own_wc(wc, scope) -> bool:
    """True if the workcenter is in the caller's own plant/shopfloor (not merely shared with him)."""
    if scope is None or scope["unrestricted"]:
        return True
    if wc.plant_code not in scope["plants"]:
        return False
    floors = scope["plant_floors"].get(wc.plant_code)
    return floors is None or wc.shopfloor_name in floors


@app.get("/api/workcenters")
def get_workcenters(db: Session = Depends(init_db), token_data=Depends(verify_token)):
    scope = db.info.get("scope")
    return [
        {
            "id": wc.id,
            "workcenter_code": wc.workcenter_code,
            "workcenter_name": wc.workcenter_name,
            "shopfloor_name": wc.shopfloor_name,
            "plant_code": wc.plant_code,
            "is_shared": not _is_own_wc(wc, scope),    # UI: show read-only
        }
        for wc in db.query(WorkCenter).all()
    ]


