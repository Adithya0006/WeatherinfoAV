def get_scope(payload=Depends(verify_token)):
    """
    userProfiles.access_level says HOW the user's access is defined:
        Company    -> company_code (or company): every plant under that company
        SBU        -> sbu: every plant of that SBU, plus every row/user carrying that SBU text
        Plant      -> plant_code (one or many), all shopfloors
        Shopfloor  -> plant_code + shopfloor (+ workcenters shared with his products)
    Anything else / empty => no access.  Super admins come from SUPER_ADMIN_IDS.
    """
    if not isinstance(payload, dict):
        return None                       # JWT validation off and no readable token (dev only)

    staff = payload.get("id")
    if not staff:
        return _scope(deny_all=True)

    db = session()                        # plain session: no scope attached, so no recursion
    try:
        u = db.query(UserProfile).filter(UserProfile.userID == staff).first()
        if u is None:
            return _scope(deny_all=True)

        if str(staff) in SUPER_ADMIN_IDS:
            return _scope(unrestricted=True, rank=ACCESS_RANK["super_admin"],
                          access_levels=["super_admin"])

        level = _normalize_level(u.access_level)
        if level not in SCOPE_TYPES:
            return _scope(deny_all=True, access_levels=[level])

        plants, floors, sbu_list = [], [], []

        if level == "company":
            codes = to_list(u.company_code) or to_list(u.company)
            if codes:
                cond = or_(*[Plant.company.like(f"{c}%") for c in codes])
                plants = [p for (p,) in db.query(Plant.plant_code).filter(cond).all()]

        elif level == "sbu":
            sbu_list = to_list(u.sbu)
            if sbu_list:
                # 1) plants whose plants.sbu contains the SBU text or its numeric code
                keys = set(sbu_list)
                for s in sbu_list:
                    keys.update(re.findall(r"\d{3,}", s))        # "Components-9150" -> "9150"
                cond = or_(*[Plant.sbu.like(f"%{k}%") for k in keys])
                plants += [p for (p,) in db.query(Plant.plant_code).filter(cond).all()]

                # 2) plants of every user that belongs to the same SBU
                for (pc,) in db.query(UserProfile.plant_code).filter(UserProfile.sbu.in_(sbu_list)).all():
                    plants += to_list(pc)

            # 3) the admin's own plant(s)
            plants += to_list(u.plant_code)

        elif level == "plant":
            plants = to_list(u.plant_code)

        elif level == "shopfloor":
            plants = to_list(u.plant_code)
            floors = to_list(u.shopfloor)
            if not floors:                                   # never widen to the whole plant
                return _scope(deny_all=True, access_levels=[level])

        plants = list(dict.fromkeys(plants))                 # de-duplicate, keep order

        # An SBU admin is allowed even with no plants: SBU-column filtering still applies
        if not plants and not sbu_list:
            return _scope(deny_all=True, access_levels=[level])

        wc_codes, wc_names = {}, {}
        if floors:
            for p in plants:
                q = db.query(WorkCenter.workcenter_code, WorkCenter.workcenter_name).filter(
                    WorkCenter.plant_code == p,
                    WorkCenter.shopfloor_name.in_(floors),
                )
                for code, name in q.all():
                    if code:
                        wc_codes.setdefault(p, []).append(code)
                    if name:
                        wc_names.setdefault(p, []).append(name)

        # ---- NEW: workcenters shared with this shopfloor admin ----
        shared_codes, shared_names = {}, {}
        if floors:
            shared_codes, shared_names = compute_shared_wc(db, plants, floors, wc_codes, wc_names)

        return _scope(
            rank=LEVEL_RANK[level],
            access_levels=[level],
            plants=plants,
            sbus=sbu_list,
            plant_floors={p: (sorted(floors) if floors else None) for p in plants},
            plant_wc_codes=wc_codes,
            plant_wc_names=wc_names,
            shared_wc_codes=shared_codes,       # NEW
            shared_wc_names=shared_names,       # NEW
        )
    finally:
        db.close()
