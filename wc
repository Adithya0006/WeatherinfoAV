def _scope(**kw):
    s = {
        "unrestricted": False,   # True only for SUPER_ADMIN_IDS
        "deny_all": False,       # True => user sees nothing
        "rank": -1,
        "access_levels": [],
        "plants": [],
        "plant_floors": {},      # plant -> [shopfloors]  or None (= all shopfloors)
        "plant_wc_codes": {},    # plant -> [workcenter_code] (only for floor-restricted plants)
        "plant_wc_names": {},    # plant -> [workcenter_name]
        "shared_wc_codes": {},   # NEW: plant -> [workcenter_code] shared with this shopfloor admin
        "shared_wc_names": {},   # NEW: plant -> [workcenter_name]
        "companies": [],         # only for tables that have no plant column (unused for now)
        "sbus": [],
    }
    s.update(kw)
    return s
