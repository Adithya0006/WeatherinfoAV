import time

# Which tables also show "shared" workcenters. Keep this to WorkCenter only,
# otherwise equipment/maintenance endpoints would leak other plants' machines.
SHARED_VISIBLE = (WorkCenter,)

_shared_cache = {}      # (plants, floors) -> (expires_at, codes, names)
SHARED_TTL = 60         # seconds


def compute_shared_wc(db, plants, floors, wc_codes, wc_names):
    """
    Workcenters (of any plant) that the shopfloor admin's products depend on,
    excluding the admin's own workcenters.
    Chain: product -> ProductWorkflowMapping -> stage -> Equipments -> (plant, workcenter_name) -> WorkCenter.workcenter_code
    Returns ({plant: [workcenter_code]}, {plant: [workcenter_name]})
    """
    key = (tuple(sorted(plants)), tuple(sorted(floors)))
    hit = _shared_cache.get(key)
    if hit and hit[0] > time.time():
        return hit[1], hit[2]

    # 1) products of my shopfloor(s)
    my_parts = {p for (p,) in db.query(ProductTypeMaster.part_number).filter(
        ProductTypeMaster.plant_code.in_(plants),
        ProductTypeMaster.shopfloor.in_(floors),
    ).all()}

    # fallback: products that pass through a stage having equipment in MY workcenters
    if not my_parts:
        own_stages = set()
        for p, names in wc_names.items():
            own_stages.update(s for (s,) in db.query(Equipments.stage_id).filter(
                Equipments.plant_code == p,
                Equipments.workcenter_name.in_(names),
                Equipments.stage_id.isnot(None),
            ).distinct().all())
        if own_stages:
            my_parts = {p for (p,) in db.query(ProductWorkflowMapping.product_part_number).filter(
                ProductWorkflowMapping.flow_step_id.in_(own_stages),
            ).distinct().all()}

    codes, names_out = {}, {}
    if my_parts:
        # 2) stages of those products
        stage_ids = [s for (s,) in db.query(ProductWorkflowMapping.flow_step_id).filter(
            ProductWorkflowMapping.product_part_number.in_(my_parts),
        ).distinct().all() if s is not None]

        # 3) workcenters of the machines on those stages
        pairs = []
        if stage_ids:
            pairs = db.query(Equipments.plant_code, Equipments.workcenter_name).filter(
                Equipments.stage_id.in_(stage_ids),
                Equipments.workcenter_name.isnot(None),
                Equipments.plant_code.isnot(None),
            ).distinct().all()

        by_plant = {}
        for pc, wn in pairs:
            by_plant.setdefault(pc, set()).add(wn)

        # 4) (plant, name) -> workcenter_code; drop my own workcenters
        for pc, nm in by_plant.items():
            rows = db.query(WorkCenter.workcenter_code, WorkCenter.workcenter_name).filter(
                WorkCenter.plant_code == pc,
                WorkCenter.workcenter_name.in_(list(nm)),
            ).all()
            for code, name in rows:
                if code and code not in wc_codes.get(pc, []):
                    codes.setdefault(pc, set()).add(code)
                    if name:
                        names_out.setdefault(pc, set()).add(name)

    codes = {k: sorted(v) for k, v in codes.items()}
    names_out = {k: sorted(v) for k, v in names_out.items()}
    _shared_cache[key] = (time.time() + SHARED_TTL, codes, names_out)
    return codes, names_out
```

