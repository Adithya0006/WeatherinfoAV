def _plant_clause(M, cols, scope):
    plant_col = getattr(M, cols["plant"])
    floor_col = getattr(M, cols["shopfloor"]) if "shopfloor" in cols else None
    code_col = getattr(M, cols["workcenter_code"]) if "workcenter_code" in cols else None
    name_col = getattr(M, cols["workcenter_name"]) if "workcenter_name" in cols else None

    per_plant = []
    for p in scope["plants"]:
        floors = scope["plant_floors"].get(p)
        if floors is None:                                   # whole plant
            per_plant.append(plant_col == p)
        elif floor_col is not None:
            per_plant.append(and_(plant_col == p, floor_col.in_(floors)))
        elif code_col is not None:
            per_plant.append(and_(plant_col == p, code_col.in_(scope["plant_wc_codes"].get(p, []))))
        elif name_col is not None:
            per_plant.append(and_(plant_col == p, name_col.in_(scope["plant_wc_names"].get(p, []))))
        else:                                                # table has no floor info
            per_plant.append(plant_col == p)

    # ---- NEW: workcenters shared with me (matched on plant + workcenter_code) ----
    if M in SHARED_VISIBLE:
        if code_col is not None:
            for p, codes in scope.get("shared_wc_codes", {}).items():
                if codes:
                    per_plant.append(and_(plant_col == p, code_col.in_(codes)))
        elif name_col is not None:
            for p, names in scope.get("shared_wc_names", {}).items():
                if names:
                    per_plant.append(and_(plant_col == p, name_col.in_(names)))

    return or_(*per_plant) if per_plant else false()
