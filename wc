@app.put("/api/workcenters/{wc_id}")
def update_workcenter(wc_id: int, payload: dict, db: Session = Depends(init_db), token_data=Depends(verify_token)):
    wc = db.query(WorkCenter).filter(WorkCenter.id == wc_id).first()
    if not wc:
        raise HTTPException(status_code=404, detail="Work Center not found")
    if not _is_own_wc(wc, db.info.get("scope")):
        raise HTTPException(status_code=403, detail="Shared work center is read-only")

    if "workcenter_name" in payload:
        wc.workcenter_name = payload["workcenter_name"]
    if "shopfloor_name" in payload:
        wc.shopfloor_name = payload["shopfloor_name"]

    db.commit()
    return {"message": "Work center updated successfully"}


@app.delete("/api/workcenters/{wc_id}")
def delete_workcenter(wc_id: int, db: Session = Depends(init_db), token_data=Depends(verify_token)):
    wc = db.query(WorkCenter).filter(WorkCenter.id == wc_id).first()
    if not wc:
        raise HTTPException(status_code=404, detail="Work Center not found")
    if not _is_own_wc(wc, db.info.get("scope")):
        raise HTTPException(status_code=403, detail="Shared work center is read-only")

    db.delete(wc)
    db.commit()
    return {"message": "Work center deleted successfully"}
